experiment:
  name: EWLDTonality
  output_root: ../outputs
  models:
  - aria_embedding
  - phrase_vae
models:
  aria_embedding:
    type: aria_embedding
    repo_id: loubb/aria-medium-embedding
    checkpoint_filename: model.safetensors
    model_config_name: medium-emb
    device: cpu
  phrase_vae:
    type: phrase_vae
    repo_id: LongshenOu/phrase-vae
    device: cpu
    trim: 16
