axes:
- name: avg_a_major_vs_d_major
  query_a: avg_a_major
  query_b: avg_d_major
  method: explicit
- name: avg_a_minor_vs_d_minor
  query_a: avg_a_minor
  query_b: avg_d_minor
  method: explicit
- name: med_a_major_vs_d_major
  query_a: med_a_major
  query_b: med_d_major
  method: explicit
- name: med_a_minor_vs_d_minor
  query_a: med_a_minor
  query_b: med_d_minor
  method: explicit
- name: pca01
  query_a: avg_a_major
  query_b: avg_a_major
  method: pca_component
  params:
    component_index: 0
- name: pca02
  query_a: avg_a_major
  query_b: avg_a_major
  method: pca_component
  params:
    component_index: 1
plots:
  tonality_pca_components:
    axes:
    - pca01
    - pca02
    options:
      origin_strategy: mean
      lda_groups: true
      averaged_only: true
      group_filter: all
      cosine_references: &id024
      - avg_c_major
      - avg_a_major
  tonality_averages:
    axes: &id025
    - avg_a_major_vs_d_major
    - avg_a_minor_vs_d_minor
    options:
      origin_strategy: mean
      lda_groups: true
      averaged_only: true
      group_filter: average
      cosine_references: *id024
  tonality_averages_mds:
    axes: *id025
    options:
      origin_strategy: mean
      lda_groups: true
      mds: true
      averaged_only: true
      group_filter: average
  tonality_averages_pca_only:
    axes: *id025
    options:
      origin_strategy: mean
      lda_groups: true
      pca: true
      averaged_only: true
      group_filter: average
      cosine_references: *id024
  tonality_averages_orthonormalize_only:
    axes: *id025
    options:
      origin_strategy: mean
      lda_groups: true
      orthonormalize: true
      averaged_only: true
      group_filter: average
      cosine_references: *id024
  tonality_averages_pca_and_orthonormalize:
    axes: *id025
    options:
      origin_strategy: mean
      lda_groups: true
      pca: true
      orthonormalize: true
      averaged_only: true
      group_filter: average
      cosine_references: *id024
  tonality_medians:
    axes: &id026
    - med_a_major_vs_d_major
    - med_a_minor_vs_d_minor
    options:
      origin_strategy: mean
      lda_groups: true
      averaged_only: true
      group_filter: median
      cosine_references: *id024
  tonality_medians_mds:
    axes: *id026
